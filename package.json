{
  "name": "reviewloop",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build -w @reviewloop/widget && concurrently -n api,web -c magenta,cyan \"npm run dev -w @reviewloop/api\" \"npm run dev -w @reviewloop/web\"",
    "build": "npm run build -w @reviewloop/widget && npm run build -w @reviewloop/api",
    "build:web": "npm run build -w @reviewloop/web",
    "start": "node server.cjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "oxlint apps packages",
    "seed": "npm run seed -w @reviewloop/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
