# Copy to apps/api/.env. Leave MONGODB_URI unset locally to use an in-memory
# MongoDB that is seeded on every start.
MONGODB_URI=
MONGODB_DB=reviewloop

PORT=8787
# Comma-separated origins allowed to call the dashboard API.
CORS_ORIGINS=http://localhost:5173
# Where the dashboard lives. Used for the review link in webhook payloads.
PUBLIC_APP_URL=https://reviewloop.automatemonday.com/

# Optional. Unset means AI assist is off and submissions are stored unscored.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional. A Zapier catch hook or https://webhook.site URL.
WEBHOOK_URL=
WEBHOOK_SECRET=change-me
